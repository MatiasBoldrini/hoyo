# Common server-only settings. Set with `supabase secrets set --env-file ...`;
# never expose these as VITE_* variables or commit real values.
APP_ENV=production
PAYMENT_PROVIDER=paypal
PAYMENT_ITEM_NAME=Hoyo takeover
CHECKOUT_TTL_SECONDS=900
CORS_ALLOWED_ORIGINS=https://app.example.com
PAYMENT_REDIRECT_ORIGINS=https://app.example.com

# PayPal Orders v2 (required when PAYMENT_PROVIDER=paypal)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
PAYPAL_CAPTURE_URL=https://your-project-ref.supabase.co/functions/v1/payment-paypal-capture
PAYMENT_RETURN_SECRET=replace-with-at-least-32-random-characters

# Optional Stripe provider (required only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret

# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY into hosted Edge Functions.

# Local-only provider (set PAYMENT_PROVIDER=dev and APP_ENV=development).
# It is rejected unless SUPABASE_URL points to localhost.
# DEV_CHECKOUT_URL=http://localhost:5173/dev-checkout
# DEV_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
